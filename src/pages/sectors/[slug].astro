---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { sectors, type Sector } from '../../data/sectors';
import { img, hasImg } from '../../lib/images';

export function getStaticPaths() {
  return sectors.map((s) => ({ params: { slug: s.slug }, props: { sector: s } }));
}
const { sector } = Astro.props as { sector: Sector };
const f = sector.featured;
const specs = [['Project cost', f.cost], ['Size', f.size], ['Construction', f.type], ['Partner', f.partner]].filter(([, v]) => v);
const others = sectors.filter((s) => s.slug !== sector.slug).slice(0, 6);
---
<Base title={`${sector.title} Electrical Contractor`} description={`${sector.intro} NCN Electric ${sector.title.toLowerCase()} projects in Southwest Florida.`} image={sector.image}>
  <PageHero eyebrow="Sector" title={sector.title} lead={sector.intro} image={sector.image} />
  <section class="section">
    <div class="container split feat">
      {hasImg(f.image) && <div class="photo reveal"><Image src={img(f.image!)} alt={f.name} widths={[700, 1200]} sizes="(max-width: 900px) 100vw, 50vw" /></div>}
      <div class="reveal" style="--d:.08s">
        <span class="eyebrow">Featured project</span>
        <h2>{f.name}</h2>
        <p class="loc">{f.location}</p>
        <p class="lead">{f.story}</p>
        {specs.length > 0 && <dl class="specs">{specs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>}
      </div>
    </div>
  </section>
  {sector.more.length > 0 && (
    <section class="section bg-soft">
      <div class="container">
        <div class="section-head reveal"><span class="eyebrow">More {sector.title.toLowerCase()} projects</span><h2>Built by NCN.</h2></div>
        <div class="grid grid-3">
          {sector.more.map((p, i) => (
            <article class="card more reveal" style={`--d:${(i % 3) * 0.06}s`}>
              {hasImg(p.image) && <div class="pic"><Image src={img(p.image!)} alt={p.name} widths={[500, 800]} sizes="(max-width: 700px) 100vw, 33vw" /></div>}
              <div class="body">
                <h3>{p.name}</h3><p class="loc">{p.location}</p>
                {p.details && <p class="muted">{p.details}</p>}
                <div class="tags">{[p.cost, p.size, p.type].filter(Boolean).map((t) => <span class="pill">{t}</span>)}</div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
  <section class="section tight">
    <div class="container">
      <h2 class="small-h">Other sectors</h2>
      <div class="chips">{others.map((s) => <a class="pill chip" href={`/sectors/${s.slug}`}>{s.title}</a>)}<a class="pill chip" href="/sectors">All sectors</a></div>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .feat .photo { aspect-ratio: 4/3; }
  .loc { color: var(--blue); font-weight: 700; margin-top: -.3em; }
  .specs { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 24px 0 0; }
  .specs div { padding: 16px; border-radius: 14px; background: var(--bg); border: 1px solid var(--line); }
  .specs dt { font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); font-weight: 700; }
  .specs dd { margin: 4px 0 0; font-weight: 700; color: var(--navy-900); }
  .more { padding: 0; overflow: hidden; }
  .pic { aspect-ratio: 16/10; overflow: hidden; }
  .pic :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .body { padding: 22px; }
  .body h3 { margin-bottom: 4px; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .small-h { font-size: 1.3rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { text-decoration: none; padding: 10px 16px; font-size: .92rem; transition: background .2s; }
  .chip:hover { background: var(--navy); color: #fff; }
</style>
