---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { site } from '../lib/site';
import { img } from '../lib/images';
import { getImage } from 'astro:assets';

interface Props { title: string; description: string; image?: string; heroDark?: boolean; noindex?: boolean }
const { title, description, image = 'hero/srq-tower.jpg', heroDark = true, noindex = false } = Astro.props;
const fullTitle = title === site.name ? `${site.name} | Commercial Electrical Contractor in Southwest Florida` : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({ src: img(image), width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const favicon = await getImage({ src: img('brand/logo.png'), width: 64, height: 64, format: 'png' });
const touch = await getImage({ src: img('brand/logo.png'), width: 180, height: 180, format: 'png' });
const org = {
  '@context': 'https://schema.org', '@type': 'Electrician', name: site.legalName, url: 'https://www.ncnelectric.com',
  telephone: '+1-941-488-0005', email: site.email, foundingDate: String(site.founded), logo: new URL(touch.src, Astro.site).href,
  image: new URL(og.src, Astro.site).href, sameAs: [site.linkedin],
  address: { '@type': 'PostalAddress', streetAddress: site.offices[0].street, addressLocality: 'Venice', addressRegion: 'FL', postalCode: '34292', addressCountry: 'US' },
  areaServed: site.serviceArea.map(c => ({ '@type': 'City', name: `${c}, FL` })),
  openingHours: 'Mo-Fr 07:00-16:30',
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#141039" />
  <link rel="icon" type="image/png" href={favicon.src} />
  <link rel="apple-touch-icon" href={touch.src} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(og.src, Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body class={heroDark ? 'hero-dark' : 'hero-light'}>
  <a class="skip" href="#main">Skip to content</a>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
  <MobileBar />
  <script>
    // Reveal-on-scroll and animated counters.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const co = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue; co.unobserve(e.target);
        const el = e.target as HTMLElement; const to = Number(el.dataset.count); const from = Number(el.dataset.from ?? 0);
        if (reduce) { el.textContent = String(to); continue; }
        const t0 = performance.now(), dur = 1600;
        const tick = (t: number) => { const p = Math.min(1, (t - t0) / dur); const v = Math.round(from + (to - from) * (1 - Math.pow(1 - p, 3))); el.textContent = String(v); if (p < 1) requestAnimationFrame(tick); };
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.6 });
    document.querySelectorAll('[data-count]').forEach((el) => co.observe(el));
  </script>
</body>
</html>
