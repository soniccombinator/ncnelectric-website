---
// Dark photo banner used at the top of inner pages.
import { Image } from 'astro:assets';
import { img } from '../lib/images';
interface Props { eyebrow?: string; title: string; lead?: string; image: string; position?: string }
const { eyebrow, title, lead, image, position = 'center' } = Astro.props;
---
<section class="page-hero">
  <Image src={img(image)} alt="" class="bg" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" style={`object-position:${position}`} />
  <div class="shade" aria-hidden="true"></div>
  <div class="container inner">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
<style>
  .page-hero { position: relative; isolation: isolate; min-height: clamp(420px, 58vh, 600px); display: flex; align-items: flex-end; color: #fff; overflow: hidden; background: var(--navy-900); }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; animation: kb 18s ease-out both; }
  .shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(12,10,38,.55) 0%, rgba(12,10,38,.35) 40%, rgba(12,10,38,.92) 100%), linear-gradient(90deg, rgba(20,16,57,.75), transparent 70%); }
  .inner { padding: 150px 0 64px; }
  h1 { color: #fff; max-width: 18ch; }
  .eyebrow { color: var(--electric); }
  .lead { color: #d5d8f0; }
  @keyframes kb { from { transform: scale(1.12); } to { transform: scale(1); } }
</style>
