---
import { Image } from 'astro:assets';
import { clients } from '../data/content';
import { img } from '../lib/images';
const row = [...clients, ...clients];
---
<section class="marquee" aria-label="General contractors we work with">
  <p>Trusted by Southwest Florida's leading general contractors</p>
  <div class="viewport">
    <div class="belt">
      {row.map((c, i) => <Image src={img(c.logo)} alt={i < clients.length ? c.name : ''} aria-hidden={i >= clients.length ? 'true' : undefined} height={52} width={Math.round(52 * img(c.logo).width / img(c.logo).height)} />)}
    </div>
  </div>
</section>
<style>
  .marquee { padding: 36px 0 30px; border-bottom: 1px solid var(--line); background: #fff; }
  p { text-align: center; margin: 0 0 20px; font-size: .8rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
  .viewport { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .belt { display: flex; align-items: center; gap: 64px; width: max-content; animation: slide 40s linear infinite; }
  .belt :global(img) { height: 52px; width: auto; max-width: 180px; object-fit: contain; filter: grayscale(1); opacity: .7; transition: filter .3s, opacity .3s; }
  .belt :global(img:hover) { filter: none; opacity: 1; }
  .marquee:hover .belt { animation-play-state: paused; }
  @keyframes slide { to { transform: translateX(-50%); } }
</style>
