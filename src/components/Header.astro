---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { nav, site } from '../lib/site';
import { img } from '../lib/images';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<header class="site-header" data-header>
  <div class="container bar">
    <a href="/" class="brand" aria-label="NCN Electric home">
      <Image src={img('brand/logo.png')} alt="" width={52} height={52} loading="eager" />
      <span class="brand-text"><strong>NCN Electric</strong><small>Since {site.founded}</small></span>
    </a>
    <nav class="nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li class={item.children ? 'has-sub' : ''}>
            <a href={item.href} class:list={[{ active: active(item.href), highlight: item.highlight }]} aria-current={active(item.href) ? 'page' : undefined}>
              {item.highlight && <Icon name="bolt" size={16} />}{item.label}
            </a>
            {item.children && (
              <ul class="sub">{item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="actions">
      <a href={site.phoneHref} class="phone"><Icon name="phone" size={18} />{site.phone}</a>
      <a href="/contact#quote" class="btn btn-primary btn-sm">Get a Quote</a>
      <button class="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="drawer" data-menu><Icon name="menu" /></button>
    </div>
  </div>
  <div class="drawer" id="drawer" hidden data-drawer>
    <nav aria-label="Mobile">
      {nav.map((item) => (
        <>
          <a href={item.href} class:list={[{ highlight: item.highlight }]}>{item.label}</a>
          {item.children?.filter((c) => c.href !== item.href).map((c) => <a href={c.href} class="child">{c.label}</a>)}
        </>
      ))}
      <a href={site.phoneHref} class="btn btn-dark"><Icon name="phone" size={18} /> Call {site.phone}</a>
      <a href="/contact#quote" class="btn btn-primary">Get a Quote</a>
    </nav>
  </div>
</header>

<style>
  .site-header { position: fixed; inset: 0 0 auto; z-index: 50; transition: background .35s, box-shadow .35s, backdrop-filter .35s; }
  .bar { display: flex; align-items: center; gap: 24px; height: 84px; transition: height .35s; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; flex: none; color: inherit; }
  .brand:hover { color: inherit; }
  .brand :global(img) { width: 52px; height: 52px; border-radius: 50%; background: #fff; box-shadow: 0 2px 12px rgba(0,0,0,.18); }
  .brand-text { display: flex; flex-direction: column; line-height: 1.05; }
  .brand-text strong { font-family: var(--display); font-variation-settings: 'wdth' 112; font-size: 1.25rem; font-weight: 800; letter-spacing: .01em; }
  .brand-text small { font-size: .7rem; letter-spacing: .2em; text-transform: uppercase; opacity: .75; margin-top: 3px; }
  .nav { margin-left: auto; }
  .nav ul { list-style: none; display: flex; gap: 4px; margin: 0; padding: 0; }
  .nav a { display: inline-flex; align-items: center; gap: 6px; padding: 10px 14px; border-radius: 999px; font-weight: 600; font-size: .95rem; text-decoration: none; transition: background .2s, color .2s; }
  .nav a.highlight { color: var(--amber); }
  .has-sub { position: relative; }
  .sub { position: absolute; top: 100%; left: 0; min-width: 190px; padding: 8px !important; background: #fff; border-radius: 14px; box-shadow: var(--shadow-lg); flex-direction: column; opacity: 0; visibility: hidden; transform: translateY(6px); transition: .2s; }
  .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; transform: none; }
  .sub a { color: var(--navy-900) !important; width: 100%; border-radius: 10px; }
  .sub a:hover { background: var(--bg) !important; }
  .actions { display: flex; align-items: center; gap: 14px; }
  .phone { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; text-decoration: none; white-space: nowrap; }
  .btn-sm { padding: 11px 20px; font-size: .92rem; }
  .menu-btn { display: none; background: none; border: 0; padding: 8px; cursor: pointer; color: inherit; }

  /* Over a dark hero: white text until scrolled */
  :global(body.hero-dark) .site-header:not(.scrolled) { color: #fff; }
  :global(body.hero-dark) .site-header:not(.scrolled) .nav a, :global(body.hero-dark) .site-header:not(.scrolled) .phone { color: #fff; }
  :global(body.hero-dark) .site-header:not(.scrolled) .nav a.highlight { color: var(--amber); }
  :global(body.hero-dark) .site-header:not(.scrolled) .nav a:hover { background: rgba(255,255,255,.12); }
  .site-header.scrolled, :global(body.hero-light) .site-header { background: rgba(255,255,255,.9); backdrop-filter: saturate(1.4) blur(14px); box-shadow: 0 1px 0 var(--line), 0 10px 30px rgba(20,16,57,.06); color: var(--navy-900); }
  .site-header.scrolled .bar { height: 70px; }
  .site-header.scrolled .nav a, :global(body.hero-light) .site-header .nav a, .site-header.scrolled .phone, :global(body.hero-light) .site-header .phone { color: var(--navy-900); }
  .site-header.scrolled .nav a.highlight, :global(body.hero-light) .site-header .nav a.highlight { color: var(--amber-600); }
  .site-header.scrolled .nav a:hover, :global(body.hero-light) .site-header .nav a:hover, .nav a.active { background: rgba(41,35,98,.08); }
  :global(body.hero-dark) .site-header:not(.scrolled) .nav a.active { background: rgba(255,255,255,.14); }

  .drawer { background: #fff; color: var(--navy-900); border-top: 1px solid var(--line); box-shadow: var(--shadow-lg); max-height: calc(100vh - 70px); overflow: auto; }
  .drawer nav { display: flex; flex-direction: column; padding: 16px 20px 24px; gap: 4px; }
  .drawer a:not(.btn) { padding: 14px 6px; font-size: 1.1rem; font-weight: 700; color: var(--navy-900); text-decoration: none; border-bottom: 1px solid var(--line); }
  .drawer a.child { padding-left: 22px; font-weight: 500; font-size: 1rem; }
  .drawer a.highlight { color: var(--amber-600); }
  .drawer .btn { margin-top: 12px; }

  @media (max-width: 1180px) { .phone { display: none; } }
  @media (max-width: 1020px) {
    .nav { display: none; }
    .menu-btn { display: inline-flex; }
    .actions { margin-left: auto; }
  }
  @media (max-width: 520px) { .actions .btn { display: none; } .bar { height: 72px; } }
</style>

<script>
  const header = document.querySelector('[data-header]')!;
  const onScroll = () => header.classList.toggle('scrolled', scrollY > 24);
  addEventListener('scroll', onScroll, { passive: true }); onScroll();
  const btn = document.querySelector('[data-menu]') as HTMLButtonElement;
  const drawer = document.querySelector('[data-drawer]') as HTMLElement;
  btn.addEventListener('click', () => {
    const open = drawer.hidden; drawer.hidden = !open; btn.setAttribute('aria-expanded', String(open));
    header.classList.toggle('scrolled', open || scrollY > 24);
    btn.innerHTML = open ? '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>' : '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>';
  });
</script>
